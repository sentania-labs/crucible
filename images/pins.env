# Shared build pins for the Crucible worker base images.
# Every value here is a build input: images/build.sh hashes this file, the
# harness Dockerfile, and itself into the crucible.build_inputs label, and the
# short hash becomes the <build> part of the image tag. Change a pin, get a
# new tag. Per-harness pins (CLI version, download checksum) live as ARG
# defaults in images/<harness>/Dockerfile.

# debian:bookworm-slim, linux/amd64 manifest, as published 2026-08-24.
BASE_IMAGE=docker.io/library/debian:bookworm-slim@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867

# apt reads from snapshot.debian.org at this instant, so the package set is
# frozen even after the live mirror moves on. Versions below are the
# candidates at that snapshot; pinning them makes a snapshot bump loud.
DEBIAN_SNAPSHOT=20260916T000000Z
GIT_VERSION=1:2.39.5-0+deb12u3
CURL_VERSION=7.88.1-10+deb12u15
JQ_VERSION=1.6-2.1+deb12u2
CA_CERTIFICATES_VERSION=20250419~deb12u1

# Image timestamps (config, history, every file mtime) are set to this
# instant, 2026-09-16 00:00:00 UTC, the same instant as DEBIAN_SNAPSHOT.
SOURCE_DATE_EPOCH=1789516800

# BuildKit used by the docker-container builder that build.sh creates. The
# docker driver bundled in dockerd cannot emit OCI output, which is where the
# registry-style manifest digest comes from.
BUILDKIT_IMAGE=moby/buildkit:buildx-stable-1@sha256:28a898719c18a33f4e8000685287fa36fd0dd9560c6440227d3a732d79bb41d8
