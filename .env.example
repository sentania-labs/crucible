# Copy to .env (git-ignored). The compose file reads these. Change the password.
POSTGRES_PASSWORD=CHANGE_ME
CRUCIBLE_PORT=8080
# Compose profiles active when none is given on the command line: `full` runs
# everything; `docker compose --profile dev up` overrides this and starts postgres only.
COMPOSE_PROFILES=full
# Optional first-migration seed only. Runtime edits are stored as immutable policy rows.
CRUCIBLE_LOCAL_ENDPOINT_URL=https://llm.apps.int.sentania.net/v1
# These manifests are examples that track `latest`. A real deployment copies them
# into the deployer's own repository and pins the exact tag and digest there.
# CRUCIBLE_IMAGE overrides compose.yaml's checked-in default below.
#CRUCIBLE_IMAGE=ghcr.io/sentania-labs/crucible:latest
